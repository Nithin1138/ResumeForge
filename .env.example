# =============================================================================
# ATSLift / ResumeForge — Environment Configuration Reference
# =============================================================================
# Copy this file to .env or .env.local and populate with your real credentials.
# For local evaluation, default mock fallbacks are supported across all modules.

# -----------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon / Supabase)
# -----------------------------------------------------------------------------
# Direct or pooled PostgreSQL connection string. Works out-of-the-box with Neon Serverless Postgres.
# Example: postgresql://username:password@ep-dry-leaf-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/resumeforge?sslmode=prefer"

# -----------------------------------------------------------------------------
# 2. Application URL & NextAuth Authentication
# -----------------------------------------------------------------------------
# Base URL for OAuth redirects, magic links, webhooks, and email callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical NextAuth deployment URL (matches NEXT_PUBLIC_APP_URL)
NEXTAUTH_URL="http://localhost:3000"

# Cryptographic random secret used to sign NextAuth JWT sessions
# Generate a secure string: `openssl rand -base64 32`
NEXTAUTH_SECRET="your_nextauth_jwt_secret_key_minimum_32_characters"

# Optional Google OAuth Provider (for 1-click Google Sign-in)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# -----------------------------------------------------------------------------
# 3. AI Engines (Google Gemini & Groq Fallback)
# -----------------------------------------------------------------------------
# Google Gemini 2.5 API Key (Primary LLM Engine for ATS Scoring, Tailoring & Vault AI)
# Obtain from https://aistudio.google.com/
# Set to "mock" to use offline heuristic scoring & realistic mock responses
GEMINI_API_KEY="mock"

# Optional Gemini model specification (Default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_MS="22000"

# Groq Cloud API Key (Instant Low-Latency LLM Fallback when Gemini is rate-limited)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_TIMEOUT_MS="20000"

# Preferred LLM Provider ("gemini" | "groq")
LLM_PROVIDER="gemini"

# -----------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------
# Razorpay Key ID and Secret for INR Candidate Wallet & Unlock payments.
# Set to "mock" to enable instant Sandbox Bypass mode (?sandbox=true)
RAZORPAY_KEY_ID="mock"
RAZORPAY_KEY_SECRET="mock"

# Secret used to cryptographically verify Razorpay webhook signatures (HMAC SHA-256)
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret_key"

# -----------------------------------------------------------------------------
# 5. Transactional Email & Notifications (Resend / SMTP)
# -----------------------------------------------------------------------------
# Resend API Key for sending verification codes, resume delivery, and placement alerts
# Obtain from https://resend.com/
# Set to "mock" or leave unconfigured to log email output directly to server terminal
RESEND_API_KEY="mock"

# Verified custom sender address
FROM_EMAIL="ATSLift <noreply@atslift.app>"

# Optional Custom SMTP Server (Fallback if Resend is not configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# -----------------------------------------------------------------------------
# 6. Telegram Bot & Placement Automation
# -----------------------------------------------------------------------------
# Telegram Bot Token from @BotFather for candidate instant job alerts & reminders
TELEGRAM_BOT_TOKEN=""

# Inbound email domain for candidate dedicated aliases (e.g. nithin-123@inbound.atslift.app)
INBOUND_EMAIL_DOMAIN="inbound.atslift.app"

# -----------------------------------------------------------------------------
# 7. Asynchronous Task Queue (Upstash QStash)
# -----------------------------------------------------------------------------
# QStash token for scheduling campus drive reminders (3-days, 1-day, day-of)
QSTASH_TOKEN=""

# -----------------------------------------------------------------------------
# 8. Administration & Security
# -----------------------------------------------------------------------------
# Secret token for protecting administrative batch APIs and cron triggers
ADMIN_SECRET_KEY="your_secure_admin_secret_token"
