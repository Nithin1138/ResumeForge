// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminConfig {
  id                 String  @id @default("admin")
  username           String
  passwordHash       String
  bannerText         String  @default("🚀 Placement Season Hack: Get 20% off unlocked copyable resume formats today only!")
  isBannerActive     Boolean @default(true)
  dynamicPrice       Int     @default(49)
  landingVariant     String  @default("minimal")
  isFlashOfferActive Boolean @default(false)
  flashPrice         Int     @default(39)
  isReferralActive   Boolean @default(true)
  invitesRequired    Int     @default(3)

  // Dynamic Landing CMS [NEW]
  heroHeadline       String  @default("Your Projects Are Gold. Your Resume Doesn't Show It.")
  heroSubheadline    String  @default("Turn your CGPA, branch-specific skills, and raw projects into ATS-ready, recruiter-approved resume content in 2 minutes.")
  ctaText            String  @default("Build My Resume Free")
  badgeText          String  @default("Built for Indian Engineering Students")
  testimonialsJson   String  @default("[]")
  faqsJson           String  @default("[]")
  walletDiscountPercent Int  @default(10)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  password           String?
  emailVerified      DateTime?
  image              String?
  isBlocked          Boolean   @default(false)
  referralCode       String?   @unique
  referredBy         String?
  walletBalance      Int       @default(0)
  telegramLinkCode   String?   @unique
  accounts           Account[]
  sessions           Session[]
  resumes            Resume[]
  coverLetters       CoverLetter[]
  masterProfile      MasterProfile?
  telegramUser       TelegramUser?
  walletTransactions WalletTransaction[]
  atsScoreChecks     AtsScoreCheck[]
  createdAt          DateTime  @default(now())
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // TOPUP or SPEND
  amount      Int      // wallet balance added or spent (in INR)
  paidAmount  Int      // actual money paid via Razorpay (in INR)
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  sessionId     String   // For non-logged-in users
  status        String   @default("DRAFT") // DRAFT, GENERATED, PAID, EXPORTED
  resumeName    String?  // Optional name for the resume (editable in dashboard)
  
  // Input and output data stored as strings/JSON strings (SQLite friendly)
  inputData     String   // Full form input (JSON stringified)
  outputFree    String?  // Free tier output (JSON stringified teaser)
  outputFull    String?  // Full paid output (JSON stringified)
  
  // Payment
  paymentStatus String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentId     String?
  paymentLinkId String?
  amountPaid    Int?     // in paise (4900 = ₹49)
  
  // Metadata
  targetRole    String?
  branch        String?
  cgpa          String?
  college       String?
  
  // UTM & Analytics Tracking [NEW]
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  deviceType    String?  @default("desktop")
  couponCode    String?
  abandoned     Boolean  @default(false)
  categoryTag   String?  @default("blue")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  coverLetters  CoverLetter[]

  @@index([sessionId])
  @@index([paymentStatus])
}

model WaitlistEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  college   String?
  branch    String?
  createdAt DateTime @default(now())
}

model FlashProjectLog {
  id           String   @id @default(cuid())
  repoUrl      String
  projectTitle String
  status       String   // SUCCESS or ERROR
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  payload   String?  @db.Text
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String
  eventType String
  page      String
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
}

model ExperimentAssignment {
  id             String   @id @default(cuid())
  sessionId      String
  experimentName String
  variant        String
  converted      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([sessionId, experimentName])
}

model NotificationQueue {
  id          String   @id @default(cuid())
  userId      String?
  email       String
  channel     String
  triggerType String
  status      String
  retryCount  Int      @default(0)
  errorMessage String? @db.Text
  scheduledAt DateTime
  createdAt   DateTime @default(now())

  @@index([status])
}

model UserCohort {
  id                String   @id @default(cuid())
  userId            String   @unique
  signupMonth       String
  college           String?
  branch            String?
  acquisitionSource String?
  firstPaymentDate  DateTime?
  createdAt         DateTime @default(now())
}

model ResumeFeedback {
  id            String   @id @default(cuid())
  resumeId      String   @unique
  rating        Int?
  liked         Boolean  @default(true)
  comments      String?  @db.Text
  copiedText    Boolean  @default(false)
  downloadedPdf Boolean  @default(false)
  editCount     Int      @default(0)
  createdAt     DateTime @default(now())
}

model PaymentEvent {
  id            String   @id @default(cuid())
  resumeId      String
  sessionId     String
  status        String
  amount        Int
  errorMessage  String?  @db.Text
  couponUsed    String?
  retryAttempts Int      @default(0)
  createdAt     DateTime @default(now())
}

model RiskEvent {
  id           String   @id @default(cuid())
  ipAddress    String
  email        String?
  riskType     String
  severity     String
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([ipAddress])
}

model SystemQueue {
  id          String   @id @default(cuid())
  jobType     String
  status      String
  latencyMs   Int      @default(0)
  errorStack  String?  @db.Text
  createdAt   DateTime @default(now())
}

model CampusInsight {
  id                 String   @id @default(cuid())
  collegeName        String   @unique
  totalRegistrations Int      @default(0)
  conversionRate     Float    @default(0.0)
  viralityScore      Float    @default(0.0)
  activeSeason       String
  createdAt          DateTime @default(now())
}


model CoverLetter {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId          String?
  resume            Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  companyName       String
  targetRole        String
  tone              String   @default("Professional & Executive")
  
  candidateName     String
  candidateEmail    String
  candidatePhone    String?
  candidateLocation String?

  recipient         String?  @default("Hiring Manager")
  subject           String?
  salutation        String?
  openingParagraph  String   @db.Text
  bodyParagraph     String   @db.Text
  closingParagraph  String   @db.Text
  signOff           String?  @default("Sincerely,")
  categoryTag       String?  @default("blue")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([resumeId])
}

model MasterProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String?
  email              String?
  collegeEmail       String?
  dateOfBirth        String?
  phone              String?
  location           String?
  github             String?
  linkedin           String?
  portfolio          String?
  noticePeriod       String?

  leetcode           String?
  codeforces         String?
  codechef           String?
  hackerrank         String?
  gfg                String?
  codingProfilesJson String          @default("[]")

  college            String?
  branch             String?
  cgpa               String?
  graduationYear     String?
  activeBacklogs     String?         // e.g. "0", "1"
  backlogHistory     String?         // e.g. "0", "1"
  academicGapYears   String?         // e.g. "0", "1"
  educationJson      String          @default("[]")
  summary            String?         @db.Text

  skillsJson         String          @default("[]")
  projectsJson       String          @default("[]")
  experiencesJson    String          @default("[]")
  certificationsJson String          @default("[]")
  achievementsJson   String          @default("[]")
  customFieldsJson   String          @default("[]")
  pinnedSectionsJson String          @default("[]")
  profileImagesJson  String          @default("[]")
  activeImageIndex   Int             @default(0)
  customNotes        String?         @db.Text

  atsCheckEnabled    Boolean         @default(false)

  atsScoreChecks     AtsScoreCheck[]

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
}

enum PostingStatus {
  NEW
  NOTIFIED
  APPLIED
  NOT_ELIGIBLE
  SKIPPED
  EXPIRED
  MANUAL_REVIEW
}

enum ReminderType {
  THREE_DAYS_BEFORE
  ONE_DAY_BEFORE
  DAY_OF
}

model TelegramUser {
  id                    String       @id @default(cuid())
  userId                String       @unique
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramChatId        String       @unique
  telegramUsername      String?
  inboundAlias          String       @unique
  gmailVerificationCode String?
  gmailVerificationLink String?
  syncSpreadsheetUrl    String?
  createdAt             DateTime     @default(now())

  jobPostings        JobPosting[]

  @@index([telegramChatId])
  @@index([inboundAlias])
}

model JobPosting {
  id                   String          @id @default(cuid())
  telegramUserId       String
  telegramUser         TelegramUser    @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  companyName          String
  roleTitle            String
  rawEmailText         String          @db.Text
  eligibilityCriteria  String          @db.Text
  packageDetails       String?         // e.g. "12 LPA", "50k stipend", etc.
  applicationDeadline  DateTime?
  driveDate            DateTime?
  otherImportantDates  String?         @db.Text
  status               PostingStatus   @default(NEW)

  eligibilityCheckResult String?       // "eligible" | "not_eligible" | "uncertain"
  eligibilityReason      String?       @db.Text
  unmetCriteria          String?       @db.Text // JSON stringified array of unmet criteria

  createdAt            DateTime        @default(now())

  reminders            Reminder[]
  atsScoreChecks       AtsScoreCheck[]

  @@index([telegramUserId])
  @@index([status])
}

model Reminder {
  id           String       @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  sent         Boolean      @default(false)
  reminderType ReminderType
  createdAt    DateTime     @default(now())

  @@index([jobPostingId])
  @@index([scheduledFor, sent])
}

model AtsScoreCheck {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterProfileId       String?
  masterProfile         MasterProfile? @relation(fields: [masterProfileId], references: [id], onDelete: SetNull)
  myspaceResumeVersion  Int?
  jobPostingId          String?
  jobPosting            JobPosting?    @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  overallScore          Int
  keywordGaps           String         @db.Text
  structuralIssues      String         @db.Text
  contentIssues         String         @db.Text
  improvements          String         @db.Text
  strengths             String         @db.Text
  triggeredBy           String         @default("manual") // "manual" | "auto_notification"

  createdAt             DateTime       @default(now())

  @@index([userId])
  @@index([jobPostingId])
  @@index([masterProfileId])
}

