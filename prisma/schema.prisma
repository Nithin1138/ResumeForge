// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminConfig {
  id                 String  @id @default("admin")
  username           String
  passwordHash       String
  bannerText         String  @default("🚀 Placement Season Hack: Get 20% off unlocked copyable resume formats today only!")
  isBannerActive     Boolean @default(true)
  dynamicPrice       Int     @default(49)
  landingVariant     String  @default("minimal")
  isFlashOfferActive Boolean @default(false)
  flashPrice         Int     @default(39)
  isReferralActive   Boolean @default(true)
  invitesRequired    Int     @default(3)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  isBlocked     Boolean   @default(false)
  referralCode  String?   @unique
  referredBy    String?
  accounts      Account[]
  sessions      Session[]
  resumes       Resume[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  sessionId     String   // For non-logged-in users
  status        String   @default("DRAFT") // DRAFT, GENERATED, PAID, EXPORTED
  
  // Input and output data stored as strings/JSON strings (SQLite friendly)
  inputData     String   // Full form input (JSON stringified)
  outputFree    String?  // Free tier output (JSON stringified teaser)
  outputFull    String?  // Full paid output (JSON stringified)
  
  // Payment
  paymentStatus String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentId     String?
  paymentLinkId String?
  amountPaid    Int?     // in paise (4900 = ₹49)
  
  // Metadata
  targetRole    String?
  branch        String?
  cgpa          String?
  college       String?
  
  // UTM & Analytics Tracking [NEW]
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  deviceType    String?  @default("desktop")
  couponCode    String?
  abandoned     Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sessionId])
  @@index([paymentStatus])
}

model WaitlistEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  college   String?
  branch    String?
  createdAt DateTime @default(now())
}

model FlashProjectLog {
  id           String   @id @default(cuid())
  repoUrl      String
  projectTitle String
  status       String   // SUCCESS or ERROR
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
}
